{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiogram",
  "version": "0.1.0",
  "identifier": "com.root.audiogram",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audiogram",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOWNLOAD/**", "$PICTURE/**", "$DESKTOP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/macos/ffmpeg",
      "binaries/linux/ffmpeg",
      "binaries/windows/ffmpeg.exe",
      "binaries/macos/whisper-cpp"
    ],
    "resources": {
      "models/ggml-base.bin": "models/ggml-base.bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
