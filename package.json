{
  "name": "audiogram-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w audiogram -- dev",
    "build": "npm run tauri -w audiogram -- build",
    "contract:gen": "node contract/codegen.mjs",
    "fetch:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "setup:bundle": "bash scripts/setup-whisper.sh && node scripts/copy-ffmpeg.mjs",
    "postinstall": "node scripts/copy-ffmpeg.mjs || true"
  }
}
